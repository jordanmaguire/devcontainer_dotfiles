{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/claude/mods/jm-review-picker"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(git push:*)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dusc-skills hook-session-start"
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
